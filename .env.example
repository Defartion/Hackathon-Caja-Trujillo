# CuotaFlex · variables de entorno (copiar a .env y completar). NUNCA subir .env al repositorio.

# --- API ---
# Orígenes extra permitidos por CORS (URLs públicas de las apps), separados por comas
CUOTAFLEX_ORIGENES=
# URL pública de la API que usarán las apps al compilarse (docker compose / despliegue)
PUBLIC_API_URL=http://localhost:8000
# Procesos para la simulación del tablero (vacío = automático)
CUOTAFLEX_SIM_PROCESOS=

# --- Persistencia (SQLite por instantánea) ---
CUOTAFLEX_PERSISTENCIA=1
CUOTAFLEX_DB=data/cuotaflex.db

# --- Roles con PIN (apagado = sin login) ---
CUOTAFLEX_AUTH=0
CUOTAFLEX_SECRETO=cambia-esto-por-un-texto-largo-y-aleatorio
PIN_ASESOR=1111
PIN_CLIENTE=2222
PIN_SUPERVISOR=3333

# --- ENFEN (El Niño costero) ---
# demo = se cambia en vivo desde la API; oficial = lee el último comunicado del ENFEN
ENFEN_MODO=demo
ENFEN_REVISION_AUTOMATICA=0
ENFEN_REVISION_HORAS=6

# --- Notificaciones (simuladas, nunca se envían) ---
NOTIFICACIONES_CANAL=sms
NOTIFICACIONES_ARCHIVO=

# --- Apache Fineract (ver infra/fineract/) ---
FINERACT_URL=https://host.docker.internal:8443/fineract-provider/api/v1
FINERACT_TENANT=default
FINERACT_USER=mifos
FINERACT_PASSWORD=
FINERACT_VERIFY_SSL=0
# 1 = cada préstamo desembolsado se replica automáticamente en Fineract
CORE_ESPEJO=0

# --- Agente con IA generativa (opcional; sin clave se usan plantillas) ---
# Confirmar con la organización del Cajathón si se permite antes de activarlo.
CUOTAFLEX_LLM=0
CUOTAFLEX_LLM_PROVEEDOR=
CUOTAFLEX_LLM_MODELO=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
